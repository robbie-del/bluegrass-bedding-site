{
  "name": "bluegrass-bedding-site",
  "version": "1.0.0",
  "private": true,
  "description": "Static marketing site for Bluegrass Bedding (bluegrassbedding.com)",
  "type": "module",
  "scripts": {
    "dev": "serve -l 8742 .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"assets/**/*.css\"",
    "lint:html": "htmlhint \"*.html\"",
    "lint:fix": "eslint . --fix && stylelint \"assets/**/*.css\" --fix",
    "verify": "npm run lint && npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "htmlhint": "^1.7.1",
    "jsdom": "^28.0.0",
    "serve": "^14.2.5",
    "stylelint": "^17.0.0",
    "stylelint-config-standard": "^40.0.0",
    "vitest": "^3.2.4"
  }
}
